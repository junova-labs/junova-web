commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,72}$'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "Error: el mensaje de commit no cumple con Conventional Commits."
  echo "Formato esperado: <tipo>(<alcance opcional>): <descripción breve>"
  echo "Ejemplo: feat(home): agregar sección de ecosistema"
  echo ""
  exit 1
fi
