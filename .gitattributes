# Normalización automática de saltos de línea entre Windows, macOS y Linux
* text=auto eol=lf

# Archivos de código y configuración (siempre LF)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Hooks de Husky (LF obligatorio para evitar errores en shell)
.husky/* text eol=lf

# Scripts específicos de Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary

# Lockfile marcado como generado para diffs más limpios en GitHub
pnpm-lock.yaml linguist-generated=true
